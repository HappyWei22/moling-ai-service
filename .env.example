# 复制为根目录 .env 后填入真实值；.env 已被 .gitignore 忽略，不要提交密钥。
# 真实调用至少需要配置 DASHSCOPE_API_KEY；其余可按需覆盖。

# 阿里云百炼（DashScope）密钥
DASHSCOPE_API_KEY=sk-在这里填你的密钥

# OpenAI 兼容入口与模型
MOLING_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MOLING_LLM_MODEL=qwen3.8-flash

# 解析参数：结构化抽取建议温度 0，超时单位为秒
MOLING_LLM_TEMPERATURE=0
MOLING_LLM_TIMEOUT=60

# 额外请求体：qwen3 系列默认开启思考，抽取任务建议关闭；
# 若模型返回 400 提示参数不支持，把这一行改成 {}
MOLING_LLM_EXTRA_BODY={"enable_thinking": false}

# 仅用于旧版 /parse、try_parse.py --version v1 和 parsing.run_parse。
# 当前 /parse/v2 和默认 try_parse.py 固定读取 parsing/prompt_v2.md，不受此项影响。
# 此项保留 v1；改为 v2 不会切换接口协议，且新旧字段不同。
MOLING_LLM_PROMPT_VERSION=v1
